#!/usr/bin/env bash
set -Eeuo pipefail

ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
# Preserve command-line model overrides before loading local credentials. A
# secrets file may provide a convenient default, but must not silently replace
# an explicit experiment model such as ``MODEL=kimi-k3 ./run``.
CALLER_MODEL="${MODEL:-}"
CALLER_CAPX_MODEL="${CAPX_MODEL:-}"
CALLER_CAPX_API_BASE_URL="${CAPX_API_BASE_URL:-}"
CALLER_CAPX_SERVER_URL="${CAPX_SERVER_URL:-}"
CALLER_CAPX_LLM_PROTOCOL="${CAPX_LLM_PROTOCOL:-}"
CAPX_SECRET_ENV="${CAPX_SECRET_ENV:-${ROOT}/.capx_secrets.env}"
if [[ -f "${CAPX_SECRET_ENV}" ]]; then
  # shellcheck disable=SC1090
  source "${CAPX_SECRET_ENV}"
fi
if [[ -n "${CALLER_MODEL}" ]]; then
  MODEL="${CALLER_MODEL}"
elif [[ -n "${CALLER_CAPX_MODEL}" ]]; then
  MODEL="${CALLER_CAPX_MODEL}"
fi
if [[ -n "${CALLER_CAPX_API_BASE_URL}" ]]; then
  CAPX_API_BASE_URL="${CALLER_CAPX_API_BASE_URL}"
fi
if [[ -n "${CALLER_CAPX_SERVER_URL}" ]]; then
  CAPX_SERVER_URL="${CALLER_CAPX_SERVER_URL}"
fi
if [[ -n "${CALLER_CAPX_LLM_PROTOCOL}" ]]; then
  CAPX_LLM_PROTOCOL="${CALLER_CAPX_LLM_PROTOCOL}"
fi
CAPX_DISABLE_PROXY="${CAPX_DISABLE_PROXY:-0}"
if [[ "${CAPX_DISABLE_PROXY}" =~ ^(1|true|TRUE|yes|YES|on|ON)$ ]]; then
  unset HTTP_PROXY HTTPS_PROXY ALL_PROXY NO_PROXY
  unset http_proxy https_proxy all_proxy no_proxy
  export CAPX_LLM_TRUST_ENV=0
  echo "[run] proxy disabled for LLM/API requests"
fi

# Edit this block for normal use.
MODE="${MODE:-smoke}"          # smoke or quick
REPEATS="${REPEATS:-1}"        # use 3 for 3 x 10 trials
TRIALS="${TRIALS:-1}"          # use 10 for each quick batch
GPU="${GPU:-7}"                # physical GPU id; use 4/5/6/7 if free
TEMPERATURE="${TEMPERATURE:-1.0}"
# An explicit shell override wins over the model default in .capx_secrets.env.
# ``MODEL`` is preferred; ``CAPX_MODEL`` remains supported for compatibility.
MODEL="${MODEL:-glm-5.3}"
if [[ -z "${REASONING_EFFORT+x}" ]]; then
  if [[ "${MODEL,,}" == *"kimi-k3"* ]]; then
    # Kimi K3 always includes reasoning.  Keep smoke requests small by
    # default; high/max remain explicit opt-ins for experiments that need it.
    REASONING_EFFORT="low"
  else
    REASONING_EFFORT="medium"
  fi
fi
REASONING_EFFORT="${REASONING_EFFORT}"
RECORD_VIDEO="${RECORD_VIDEO:-True}"
WORKERS="${WORKERS:-1}"        # keep 1 for Isaac/UniVTAC
TRIAL_TIMEOUT_SECONDS="${TRIAL_TIMEOUT_SECONDS:-900}"
MAX_TRIAL_RETRIES="${MAX_TRIAL_RETRIES:-1}"
PROCESS_TIMEOUT_SECONDS="${PROCESS_TIMEOUT_SECONDS:-1800}"  # 0 disables whole-run watchdog
LLM_TIMEOUT_SECONDS="${LLM_TIMEOUT_SECONDS:-300}"
LLM_PREFLIGHT_TIMEOUT_SECONDS="${LLM_PREFLIGHT_TIMEOUT_SECONDS:-20}"
LLM_PREFLIGHT="${LLM_PREFLIGHT:-1}"
if [[ -z "${MAX_TOKENS+x}" ]]; then
  if [[ "${MODEL,,}" == *"kimi-k3"* ]]; then
    # K3's visible code shares the completion budget with always-on reasoning.
    # Avoid reserving an unnecessarily large request at a rate-limited gateway.
    MAX_TOKENS=8192
  else
    MAX_TOKENS=4096
  fi
fi
MAX_TOKENS="${MAX_TOKENS}"
CAPX_DISABLE_THINKING_VALUE="${CAPX_DISABLE_THINKING:-1}"
if [[ "${MODEL,,}" == *"kimi-k3"* ]]; then
  # Kimi K3 has always-on reasoning; enable_thinking=false is not part of
  # its public request contract.
  CAPX_DISABLE_THINKING_VALUE=0
fi
PERCEPTION_GPU="${PERCEPTION_GPU:-${GPU}}"
PERCEPTION_STARTUP_TIMEOUT_SECONDS="${PERCEPTION_STARTUP_TIMEOUT_SECONDS:-300}"
CAPX_PYTHON="${CAPX_PYTHON:-${ROOT}/cap-x/.venv/bin/python}"
CAPX_SAM3_CHECKPOINT="${CAPX_SAM3_CHECKPOINT:-${ROOT}/cap-x-cache/modelscope/facebook/sam3/sam3.pt}"

# Default to the current UniVTAC tactile-response selection smoke. It uses a
# fixed composable pair and task-local public probe records. Override
# CONFIG_PATH to run a baseline or an archived experiment explicitly.
CONFIG_PATH="${CONFIG_PATH:-${CAPX_CONFIG_PATH:-env_configs/univtac/tactile_memory_match_response_selection_easy_gt.yaml}}"
case "$(basename -- "${CONFIG_PATH}")" in
  tension_strap_stage_memory_control.yaml|tension_strap_stage_memory_control_visual.yaml)
    UNIVTAC_ROOT="${UNIVTAC_ROOT:-/mnt/sdc/ljz/OpenTacBench_capx}"
    TACEX_RUNTIME_ROOT="${TACEX_RUNTIME_ROOT:-${UNIVTAC_ROOT}/third_party/TacEx}"
    ;;
  *)
    UNIVTAC_ROOT="${UNIVTAC_ROOT:-/mnt/sdc/ljz/UniVTAC}"
    TACEX_RUNTIME_ROOT="${TACEX_RUNTIME_ROOT:-}"
    ;;
esac
CONDA_ENV_NAME="${CONDA_ENV_NAME:-UniVTAC}"
CONDA_SH="${CONDA_SH:-/mnt/sdc/ljz/miniforge3/etc/profile.d/conda.sh}"

# If CAPX_SERVER_URL is already defined in .capx_secrets.env or your shell,
# this value will not override it.
CAPX_API_BASE_URL="${CAPX_API_BASE_URL:-https://llm-ejq6ku0w1n2yvtv5.cn-beijing.maas.aliyuncs.com/compatible-mode/v1}"
CAPX_LLM_PROTOCOL="${CAPX_LLM_PROTOCOL:-chat_completions}"
if [[ -z "${CAPX_SERVER_URL:-}" ]]; then
  if [[ "${CAPX_LLM_PROTOCOL}" == "responses" ]]; then
    CAPX_SERVER_URL="${CAPX_API_BASE_URL%/}/responses"
  else
    CAPX_SERVER_URL="${CAPX_API_BASE_URL%/}/chat/completions"
  fi
fi
export CAPX_API_BASE_URL CAPX_SERVER_URL CAPX_LLM_PROTOCOL
export CAPX_MODEL="${MODEL}"
export LLM_PREFLIGHT_TIMEOUT_SECONDS
RUN_ROOT="${RUN_ROOT:-${ROOT}/capx-runs}"
CAPX_LIVE_PREVIEW_PATH="${CAPX_LIVE_PREVIEW_PATH:-${RUN_ROOT}/latest_preview.jpg}"
if [[ "${CONFIG_PATH}" = /* ]]; then
  CONFIG_FILE="${CONFIG_PATH}"
else
  CONFIG_FILE="${ROOT}/cap-x/${CONFIG_PATH}"
fi
if [[ ! -f "${CONFIG_FILE}" ]]; then
  echo "[run] config not found: ${CONFIG_FILE}" >&2
  exit 2
fi
CONFIG_STEM="$(basename -- "${CONFIG_FILE%.*}")"
RUN_LABEL="${RUN_LABEL:-${CONFIG_STEM}}"
RGBD_PERCEPTION_REQUIRED=0
if grep -Eq '^[[:space:]]*rgbd_perception_enabled:[[:space:]]*true([[:space:]]|$)' "${CONFIG_FILE}"; then
  RGBD_PERCEPTION_REQUIRED=1
fi
if [[ -z "${TRIAL_TIMEOUT_SECONDS}" ]]; then
  if [[ "${RGBD_PERCEPTION_REQUIRED}" == "1" ]]; then
    TRIAL_TIMEOUT_SECONDS=300
  else
    TRIAL_TIMEOUT_SECONDS=180
  fi
fi

case "${MODE}" in
  smoke|quick) ;;
  *) echo "Usage: edit MODE to smoke or quick" >&2; exit 2 ;;
esac

mkdir -p "${RUN_ROOT}"

echo "[run] root=${ROOT}"
echo "[run] mode=${MODE}, repeats=${REPEATS}, trials=${TRIALS}, gpu=${GPU}"
echo "[run] model=${MODEL}, temperature=${TEMPERATURE}, reasoning_effort=${REASONING_EFFORT}, record_video=${RECORD_VIDEO}"
echo "[run] llm_protocol=${CAPX_LLM_PROTOCOL}"
echo "[run] config=${CONFIG_FILE}"
echo "[run] trial_timeout_seconds=${TRIAL_TIMEOUT_SECONDS}, max_trial_retries=${MAX_TRIAL_RETRIES}"
echo "[run] process_timeout_seconds=${PROCESS_TIMEOUT_SECONDS}, llm_timeout_seconds=${LLM_TIMEOUT_SECONDS}"
echo "[run] server_url=${CAPX_SERVER_URL}, api_key_present=$([[ -n "${CAPX_API_KEY:-}" ]] && echo yes || echo no), max_tokens=${MAX_TOKENS}"

if [[ "${LLM_PREFLIGHT}" == "1" ]]; then
  echo "[run] llm preflight begin timeout=${LLM_PREFLIGHT_TIMEOUT_SECONDS}s"
  "${CAPX_PYTHON}" - <<'PY'
import json
import os
import sys

import requests

url = os.environ["CAPX_SERVER_URL"]
model = os.environ["CAPX_MODEL"]
timeout = float(os.environ.get("LLM_PREFLIGHT_TIMEOUT_SECONDS", "20"))
api_key = os.environ.get("CAPX_API_KEY", "")
protocol = os.environ.get("CAPX_LLM_PROTOCOL", "chat_completions").strip().lower()
if protocol == "responses":
    payload = {
        "model": model,
        "input": "Reply with OK.",
        "max_output_tokens": 8,
    }
else:
    payload = {
        "model": model,
        "messages": [{"role": "user", "content": "Reply with OK."}],
        "temperature": 0,
        "max_tokens": 8,
        "stream": False,
    }
if protocol != "responses" and model.lower().split("/")[-1].startswith("kimi-k3"):
    # Kimi K3 always reasons. Use a bounded effort for a cheap connectivity
    # check; the actual trial uses REASONING_EFFORT below.
    payload["reasoning_effort"] = "low"
headers = {"Content-Type": "application/json"}
if api_key:
    headers["Authorization"] = f"Bearer {api_key}"

disable_proxy = os.environ.get("CAPX_DISABLE_PROXY", "").strip().lower() in {
    "1", "true", "yes", "y", "on"
}
try:
    with requests.Session() as session:
        session.trust_env = not disable_proxy
        response = session.post(
            url,
            headers=headers,
            data=json.dumps(payload),
            timeout=timeout,
        )
    text = response.text[:500]
    response.raise_for_status()
    print(f"[run] llm preflight ok status={response.status_code} preview={text[:160]!r}")
except requests.HTTPError as exc:
    response = exc.response
    status = response.status_code if response is not None else "unknown"
    text = response.text[:500] if response is not None else str(exc)
    print(f"[run] llm preflight failed status={status} preview={text!r}", file=sys.stderr)
    sys.exit(1)
except Exception as exc:
    print(f"[run] llm preflight failed error={exc!r}", file=sys.stderr)
    sys.exit(1)
PY
fi

PERCEPTION_PIDS=()
PERCEPTION_LOG_DIR=""

service_ready() {
  local port="$1"
  local required_path="$2"
  python - "${port}" "${required_path}" <<'PY' >/dev/null 2>&1
import json
import sys
import urllib.request

port = int(sys.argv[1])
required_path = sys.argv[2]
try:
    with urllib.request.urlopen(
        f"http://127.0.0.1:{port}/openapi.json", timeout=1.5
    ) as response:
        schema = json.load(response)
except Exception:
    raise SystemExit(1)
raise SystemExit(0 if required_path in schema.get("paths", {}) else 1)
PY
}

cleanup_perception_services() {
  local pid
  local attempt
  for pid in "${PERCEPTION_PIDS[@]:-}"; do
    if [[ -n "${pid}" ]] && kill -0 "${pid}" 2>/dev/null; then
      kill "${pid}" 2>/dev/null || true
    fi
  done
  for attempt in $(seq 1 20); do
    local any_alive=0
    for pid in "${PERCEPTION_PIDS[@]:-}"; do
      if [[ -n "${pid}" ]] && kill -0 "${pid}" 2>/dev/null; then
        any_alive=1
      fi
    done
    [[ "${any_alive}" == "0" ]] && break
    sleep 0.25
  done
  for pid in "${PERCEPTION_PIDS[@]:-}"; do
    if [[ -n "${pid}" ]] && kill -0 "${pid}" 2>/dev/null; then
      kill -KILL "${pid}" 2>/dev/null || true
    fi
    if [[ -n "${pid}" ]]; then
      wait "${pid}" 2>/dev/null || true
    fi
  done
}

start_perception_service() {
  local name="$1"
  local port="$2"
  local required_path="$3"
  local module="$4"
  shift 4
  if service_ready "${port}" "${required_path}"; then
    echo "[run] reusing ${name} service on 127.0.0.1:${port}"
    return
  fi
  local log="${PERCEPTION_LOG_DIR}/${name}.log"
  (
    cd "${ROOT}/cap-x"
    exec env \
      CUDA_VISIBLE_DEVICES="${PERCEPTION_GPU}" \
      CAPX_SAM3_CHECKPOINT="${CAPX_SAM3_CHECKPOINT}" \
      PYTHONUNBUFFERED=1 \
      "${CAPX_PYTHON}" -m "${module}" \
        --device cuda:0 --host 127.0.0.1 --port "${port}" "$@"
  ) >"${log}" 2>&1 &
  local pid=$!
  PERCEPTION_PIDS+=("${pid}")
  echo "[run] starting ${name} pid=${pid} port=${port} log=${log}"
}

wait_for_perception_service() {
  local name="$1"
  local port="$2"
  local required_path="$3"
  local deadline=$((SECONDS + PERCEPTION_STARTUP_TIMEOUT_SECONDS))
  while ! service_ready "${port}" "${required_path}"; do
    local pid
    for pid in "${PERCEPTION_PIDS[@]:-}"; do
      if [[ -n "${pid}" ]] && ! kill -0 "${pid}" 2>/dev/null; then
        echo "[run] a perception service exited before ${name} became ready" >&2
        tail -n 40 "${PERCEPTION_LOG_DIR}"/*.log >&2 2>/dev/null || true
        return 1
      fi
    done
    if (( SECONDS >= deadline )); then
      echo "[run] ${name} did not become ready on port ${port}" >&2
      tail -n 40 "${PERCEPTION_LOG_DIR}"/*.log >&2 2>/dev/null || true
      return 1
    fi
    sleep 2
  done
  echo "[run] ${name} ready on 127.0.0.1:${port}"
}

if [[ "${RGBD_PERCEPTION_REQUIRED}" == "1" ]]; then
  if ! service_ready 8114 /segment || ! service_ready 8115 /plan; then
    if [[ ! -x "${CAPX_PYTHON}" ]]; then
      echo "[run] CaP-X Python is unavailable: ${CAPX_PYTHON}" >&2
      exit 2
    fi
  fi
  if ! service_ready 8114 /segment && [[ ! -f "${CAPX_SAM3_CHECKPOINT}" ]]; then
    echo "[run] SAM3 checkpoint is unavailable: ${CAPX_SAM3_CHECKPOINT}" >&2
    exit 2
  fi
  PERCEPTION_LOG_DIR="${RUN_ROOT}/perception_services_$(date -u +%Y%m%dT%H%M%SZ)"
  mkdir -p "${PERCEPTION_LOG_DIR}"
  trap cleanup_perception_services EXIT
  trap 'exit 130' INT TERM
  echo "[run] perception_gpu=${PERCEPTION_GPU}, logs=${PERCEPTION_LOG_DIR}"
  if [[ "${PERCEPTION_GPU}" == "${GPU}" ]]; then
    echo "[run] warning: Isaac and perception services share physical GPU ${GPU}"
  fi
  start_perception_service \
    sam3 8114 /segment capx.serving.launch_sam3_server \
    --checkpoint-path "${CAPX_SAM3_CHECKPOINT}"
  wait_for_perception_service sam3 8114 /segment
  start_perception_service \
    contact_graspnet 8115 /plan capx.serving.launch_contact_graspnet_server
  wait_for_perception_service contact_graspnet 8115 /plan
fi

for rep in $(seq 1 "${REPEATS}"); do
  if [[ "${RGBD_PERCEPTION_REQUIRED}" == "1" ]]; then
    if ! service_ready 8114 /segment || ! service_ready 8115 /plan; then
      echo "[run] perception service became unavailable before rep ${rep}" >&2
      exit 1
    fi
  fi
  ts="$(date -u +%Y%m%dT%H%M%SZ)"
  out="${RUN_ROOT}/${RUN_LABEL}_${MODE}_rep${rep}_${ts}"
  log="${out}/run.log"
  mkdir -p "${out}"
  echo "[run] starting rep ${rep}/${REPEATS}: ${out}"

  watchdog="${PROCESS_TIMEOUT_SECONDS}"
  if [[ "${watchdog}" -gt 0 ]]; then
    echo "[run] effective_process_timeout_seconds=${watchdog}"
  else
    echo "[run] process watchdog disabled"
  fi

  cmd=(
    bash "${ROOT}/capx_scripts/run_capx_univtac.sh" "${MODE}"
  )
  env_vars=(
    "CAPX_GPU=${GPU}"
    "CUDA_VISIBLE_DEVICES=${GPU}"
    "UNIVTAC_DEVICE=cuda:0"
    "UNIVTAC_ROOT=${UNIVTAC_ROOT}"
    "TACEX_RUNTIME_ROOT=${TACEX_RUNTIME_ROOT}"
    "CONDA_ENV_NAME=${CONDA_ENV_NAME}"
    "CONDA_SH=${CONDA_SH}"
    "HEADLESS=1"
    "LIVESTREAM=0"
    "OMNI_KIT_ACCEPT_EULA=YES"
    "CAPX_CONFIG_PATH=${CONFIG_PATH}"
    "CAPX_TRIALS=${TRIALS}"
    "CAPX_WORKERS=${WORKERS}"
    "CAPX_RECORD_VIDEO=${RECORD_VIDEO}"
    "PYTHONUNBUFFERED=1"
    "CAPX_TEMPERATURE=${TEMPERATURE}"
    "CAPX_REASONING_EFFORT=${REASONING_EFFORT}"
    "CAPX_MODEL=${MODEL}"
    "CAPX_LLM_TIMEOUT_SECONDS=${LLM_TIMEOUT_SECONDS}"
    "CAPX_MAX_TOKENS=${MAX_TOKENS}"
    "CAPX_DISABLE_THINKING=${CAPX_DISABLE_THINKING_VALUE}"
    "CAPX_FORCE_EXIT_AFTER_RUN=${CAPX_FORCE_EXIT_AFTER_RUN:-1}"
    "CAPX_PRESERVE_OUTPUT_DIR=${CAPX_PRESERVE_OUTPUT_DIR:-1}"
    "CAPX_TRIAL_TIMEOUT_SECONDS=${TRIAL_TIMEOUT_SECONDS}"
    "CAPX_MAX_TRIAL_RETRIES=${MAX_TRIAL_RETRIES}"
    "CAPX_API_BASE_URL=${CAPX_API_BASE_URL}"
    "CAPX_SERVER_URL=${CAPX_SERVER_URL}"
    "CAPX_LLM_PROTOCOL=${CAPX_LLM_PROTOCOL}"
    "CAPX_API_KEY=${CAPX_API_KEY:-}"
    "CAPX_OUTPUT_DIR=${out}"
    "CAPX_LIVE_PREVIEW_PATH=${CAPX_LIVE_PREVIEW_PATH}"
  )
  set +e
  # Keep both the launcher and log reader alive while the Python child closes
  # its MP4 writers. Without this, Ctrl-C can kill tee before the save logs
  # (and the final video) are written.
  interrupted=0
  trap 'interrupted=1; echo "[run] Ctrl-C received; waiting for trial video save..." >&2' INT
  env "${env_vars[@]}" timeout --foreground --signal=INT --kill-after=300s "${watchdog}s" "${cmd[@]}" 2>&1 | (trap '' INT; tee "${log}")
  rc=${PIPESTATUS[0]}
  trap - INT
  set -e
  echo "[run] rep ${rep} exit_code=${rc}, log=${log}" | tee -a "${log}"
  if [[ "${interrupted}" -eq 1 ]]; then
    exit 130
  fi
  if [[ "${rc}" -eq 124 || "${rc}" -eq 137 ]]; then
    echo "[run] rep ${rep} hit process watchdog after ${watchdog}s" | tee -a "${log}"
    exit "${rc}"
  elif [[ "${rc}" -ne 0 ]]; then
    exit "${rc}"
  fi
done

echo "[run] done"
